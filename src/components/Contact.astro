---
import { identity, ui } from '../content/site';
---
<section class="section contact container section-grid" id="contact" aria-labelledby="contact-title">
  <h2 class="section-title" id="contact-title" data-motion="reveal">{ui.contact}</h2>
  <div class="stack">
    <p class="closing" data-motion="text">{ui.closing}</p>
    <a class="button" href={identity.linkedin} target="_blank" rel="noopener noreferrer" data-motion="reveal" data-motion-delay="0.15">{ui.linkedin}<span aria-hidden="true">↗</span></a>
    <div class="contact-links" data-motion="reveal" data-motion-delay="0.2">
      <a class="text-link" href={`mailto:${identity.email}`}>{identity.email}<span aria-hidden="true">↗</span></a>
      <a class="text-link" href={identity.github} target="_blank" rel="noopener noreferrer">{ui.github}<span aria-hidden="true">↗</span></a>
    </div>
    <p class="muted small">{identity.location}</p>
  </div>
</section>
<style>
  .contact { padding-block: 140px; }
  .closing { font-size: 30px; letter-spacing: -.035em; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 8px 30px; }
  @media (max-width: 809px) { .contact { padding-block: 80px; } .closing { font-size: 26px; } }
</style>
